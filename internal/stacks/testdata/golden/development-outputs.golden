# Written by Stackwright from the Stack's files (adr/0043).

variable "stackwright_components" {
  type      = any
  default   = {}
  sensitive = false
}

variable "default_tags" {
  description = "Default tags for all resources."
  type        = map(string)
  default = {
    Stack       = "learn-stacks-deploy-aws",
    Environment = "dev"
  }
}

variable "identity_token" {
  description = "Identity token for authentication."
  type        = string
  ephemeral   = true
}

variable "regions" {
  description = "AWS regions to deploy to."
  type        = set(string)
}

variable "role_arn" {
  description = "ARN of role associated with identity token."
  type        = string
}

locals {
}

output "intance_ids" {
  value     = [for x in var.stackwright_components.instance : tolist(x.instance_ids)]
  sensitive = false
}

output "intance_private_dns" {
  value     = [for x in var.stackwright_components.instance : tolist(x.private_dns)]
  sensitive = false
}


